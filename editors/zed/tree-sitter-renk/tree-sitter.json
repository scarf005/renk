{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "renk",
      "camelcase": "Renk",
      "scope": "source.renk",
      "path": ".",
      "file-types": ["rk"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-or-later",
    "description": "Tree-sitter grammar for Renk",
    "authors": [{ "name": "scarf005" }],
    "links": { "repository": "https://github.com/scarf005/renk" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
