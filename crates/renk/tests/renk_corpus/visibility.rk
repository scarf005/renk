pub mod outer:
    pub(in crate.outer) mod inner:
        pub(super) struct Point:
            pub(super) x: i32
            pub(in crate.outer) y: i32

        enum Shape[T]:
            Dot(T)
            Line:
                from: T
                to: T

        pub(super) trait Area:
            fn area(&self) -> i32

        impl Point:
            pub(super) fn new(x: i32) -> Self = Point { x, y: x }

        impl Area for Point:
            fn area(&self) -> i32 = self.x * self.y

        pub(super) fn picked() -> i32:
            // pub(super) struct Hidden:
            let shape: Shape[i32] = Shape.Line { from: 1, to: 2 }
            match shape:
                Shape.Dot(at) => at
                Shape.Line { from, to } => from + to

    pub fn total() -> i32:
        use inner.Area
        let point = inner.Point.new(2)
        point.area() + point.x + inner.picked()
