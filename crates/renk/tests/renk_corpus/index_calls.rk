fn double(v: i32) -> i32 = v * 2

fn negate(v: i32) -> i32 = -v

fn make[T](x: T) -> T = x

pub struct Wrap[T](T)

pub struct Calls:
    table: [fn(i32) -> i32; 2]

impl Calls:
    fn table[T](&self, x: T) -> T = x

    pub fn field(&self, i: usize, x: i32) -> i32:
        let table = [double, negate]
        let picked = self.table[u8](1) as i32
        (self.table[i])(x) + table[i](picked)

pub fn bound(table: [fn(i32) -> i32; 2], flag: bool) -> i32:
    let early = make[u8](1) as i32 // make[0](1)
    let make = [double, negate]
    let mut total = early + table[1](2) + make[0](early)
    for fs in [[double, negate]]:
        total += fs[0](1)
    let apply = |fs: [fn(i32) -> i32; 2]| fs[1](3)
    if let Some(pair) = Some([double, negate]):
        total += pair[0](4)
    if flag:
        let make = [negate, double]
        total += make[0](5)
    total + apply(table) + Wrap[u8](6).0 as i32

pub fn sibling(flag: bool) -> i32:
    if flag:
        let make = [double, negate]
        return make[1](8)
    make[i32](9)
