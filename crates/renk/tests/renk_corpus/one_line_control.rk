fn count(v: Vec[u32], names: Vec[String], c: bool) -> usize:
    let mut n = 0
    for x in v.iter() { n += Vec[u32].new().len() + *x as usize }
    for name in names.iter() { n += name.len() }
    while c && n < 3 { n += std.cmp.max(1, 2) }
    if c { n += Vec[u8].new().len() } // {
    loop { break }
    if names.is_empty() { n } else { n + names[0].len() }

pub fn plus(n: usize) -> usize = n + if n > 1 then 1 else 2

pub fn times(n: usize) -> usize:
    let m = 2 * if n > 1 then n else 1
    m

pub fn less(n: usize) -> bool = n < if n > 1 then 1 else 2

pub fn indexed(A: Vec[bool], Bm: Vec[Vec[i32]], Kinds: Vec[i32], i: usize) -> i32:
    let mut n = 0
    if A[i] {
        n += 1
    } else if A[0] {
        n += 2
    }
    for x in &Bm[i] {
        n += *x
    }
    while A[i] {
        break
    }
    match Kinds[i] {
        1 => n += 1,
        _ => {}
    }
    n
