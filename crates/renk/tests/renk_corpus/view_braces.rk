use std.cell.Cell

pub struct Pair[T]:
    pub x: T
    pub y: T

pub struct Point:
    pub x: u8
    pub y: u8

// A stand-in for `view!` macros that type-checks the braces in a view body that hold no statements.
macro_rules! view:
    (<s value=$head:ident { $($field:tt)* } />) =>:
        {
            let _ = $head { $($field)* };
            "s"
        }
    (<m class=match $scrutinee:ident { $($arm:tt)* }></m>) =>:
        {
            let _ = match $scrutinee { $($arm)* };
            "m"
        }
    (<c on:click=move |$event:tt| match $scrutinee:ident { $($arm:tt)* }></c>) =>:
        {
            let handler = move |$event: u8| match $scrutinee { $($arm)* };
            handler(1);
            "c"
        }
    (<a on:click=move |$event:tt| $cell:ident.$method:ident($head:ident { $($field:tt)* })></a>) =>:
        {
            let handler = move |$event: u8| $cell.$method($head { $($field)* });
            handler(1);
            "a"
        }
    (<i on:click=move |$event:tt| if $left:ident > 0 $then:block></i>) =>:
        {
            let handler = move |$event: u8| if $left > 0 $then;
            handler(1);
            "i"
        }
    (<g value=$head:ident::<$ty:ty> { $($field:tt)* } />) =>:
        {
            let _ = $head::<$ty> { $($field)* };
            "g"
        }
    (<t> $text:literal $child:block </t>) =>:
        {
            let _ = ($text, $child);
            "t"
        }
    (<k> $child:block </k>) =>:
        {
            let _ = $child;
            "k"
        }
    (<w on:click=move |$event:tt| if $left:ident > 0 && $right:ident $then:block></w>) =>:
        {
            let handler = move |$event: u8| if $left > 0 && $right $then;
            handler(1);
            "w"
        }
    (<n class=match $scrutinee:literal { $($arm:tt)* }></n>) =>:
        {
            let _ = match $scrutinee { $($arm)* };
            "n"
        }
    (<p class=move || match $scrutinee:ident { $($arm:tt)* }></p>) =>:
        {
            let class = move || match $scrutinee { $($arm)* };
            let _ = class();
            "p"
        }
    (<f on:click=move |$event:tt| if $check:ident($($argument:tt)*) $then:block></f>) =>:
        {
            let handler = move |$event: u8| if $check($($argument)*) $then;
            handler(1);
            "f"
        }
    (<q class=move || if let $head:ident { $($field:tt)* } = $value:ident $then:block else $otherwise:block></q>) =>:
        {
            let class = move || if let $head { $($field)* } = $value $then else $otherwise;
            let _ = class();
            "q"
        }
    (<o class=move || if let Some($x:ident) = $value:ident $then:block else $otherwise:block></o>) =>:
        {
            let class = move || if let Some($x) = $value $then else $otherwise;
            let _ = class();
            "o"
        }
    (<r value=for $head:ident { $($field:tt)* } in $items:ident $body:block></r>) =>:
        {
            for $head { $($field)* } in $items $body
            "r"
        }
    (<l for> $child:block </l>) =>:
        {
            let _ = $child;
            "l"
        }
    (<x>Find a match</x> $child:block) =>:
        {
            let _ = $child;
            "x"
        }
    (<h on:click=move |$event:ident: $ty:ty| $body:block></h>) =>:
        {
            let handler = move |$event: $ty| $body;
            handler(Box::new(|_| {}));
            "h"
        }
    (<u class=move || if let $pattern:pat = $value:ident $then:block else $otherwise:block></u>) =>:
        {
            let class = move || if let $pattern = $value $then else $otherwise;
            let _ = class();
            "u"
        }
    (<z class=match $scrutinee:ident as $ty:ty { $($arm:tt)* }></z>) =>:
        {
            let _ = match $scrutinee as $ty { $($arm)* };
            "z"
        }
    (<v class=match $left:ident > $right:literal { $($arm:tt)* }></v>) =>:
        {
            let _ = match $left > $right { $($arm)* };
            "v"
        }
    (<b class=move || if let <$ty:ty>::$constant:ident = $value:ident $then:block else $otherwise:block></b>) =>:
        {
            let class = move || if let <$ty>::$constant = $value $then else $otherwise;
            let _ = class();
            "b"
        }
    (<e>match $x:ident < $y:ident, then</e> $child:block) =>:
        {
            let _ = $child;
            "e"
        }
    (<j>Find a match<br/> $child:block </j>) =>:
        {
            let _ = $child;
            "j"
        }
    (div(class=$class:literal) { $($child:ident { $text:literal })* }) =>:
        {
            $(let _ = (stringify!($child), $text);)*
            $class
        }
pub type Same[T] = T

pub fn check(n: u8) -> bool = n > 0

#[allow(unused_imports)]
pub(crate) use view

pub fn literal() -> &'static str:
    view! {
        <s value=Point {
            x: 1,
            y: 2,
        } />
    }

pub fn arms(count: &Cell[u8], n: u8) -> &'static str:
    view! {
        <m class=match n {
            0 => {
                count.set(1)
                "a"
            }
            _ => "b",
        }></m>
    }

pub fn handler(count: &Cell[u8]) -> &'static str:
    view! {
        <c on:click=move |ev| match ev {
            0 => count.set(1),
            _ => count.set(2),
        }></c>
    }

pub fn setter(point: &Cell[Point]) -> &'static str:
    view! {
        <a on:click=move |_| point.set(Point {
            x: 1,
            y: 2,
        })></a>
    }

pub fn toggle(count: &Cell[u8]) -> &'static str:
    view! {
        <i on:click=move |ev| if ev > 0 {
            count.set(1)
            count.set(2)
        }></i>
    }

pub fn sycamore() -> &'static str:
    view! {
        div(class="x") {
            p { "a" }
            p { "b" }
        }
    }

pub fn turbofish() -> &'static str:
    view! {
        <g value=Pair::<u8> {
            x: 1,
            y: 2,
        } />
    }

pub fn after_text() -> &'static str:
    view! {
        <t>
            "Value: "
            {
                let x = 1
                x
            }
        </t>
    }

pub fn after_comment() -> &'static str:
    view! {
        <k>
            // total
            {
                let x = 1
                x
            }
        </k>
    }

pub fn wrapped_condition(count: &Cell[u8], ok: bool) -> &'static str:
    view! {
        <w on:click=move |ev| if ev > 0
            && ok {
            count.set(1)
            count.set(2)
        }></w>
    }

pub fn string_scrutinee() -> &'static str:
    view! {
        <n class=match "a" {
            "a" => 1,
            _ => 2,
        }></n>
    }

pub fn turbofish_pattern(pair: Pair[u8]) -> &'static str:
    view! {
        <p class=move || match pair {
            Pair::<u8> { x, .. } => {
                let y = 1
                x + y
            }
        }></p>
    }

pub fn commented_literal() -> &'static str:
    view! {
        <s value=Point // the point
        {
            x: 1,
            y: 2,
        } />
    }

pub fn trailing_operator(count: &Cell[u8], ok: bool) -> &'static str:
    view! {
        <w on:click=move |ev| if ev > 0 &&
            ok {
            count.set(1)
            count.set(2)
        }></w>
    }

pub fn wrapped_call(count: &Cell[u8]) -> &'static str:
    view! {
        <f on:click=move |ev| if check(
            ev,
        ) {
            count.set(1)
            count.set(2)
        }></f>
    }

pub fn guard(n: u8) -> &'static str:
    view! {
        <m class=match n {
            m if m > 0 => Point {
                x: 1,
                y: 2,
            },
            _ => Point { x: 0, y: 0 },
        }></m>
    }

pub fn let_pattern(point: Point) -> &'static str:
    view! {
        <q class=move || if let Point {
            x,
            y,
        } = point {
            x + y
        } else {
            0
        }></q>
    }

pub fn let_pattern_statements(point: Point) -> &'static str:
    view! {
        <q class=move || if let Point { x, y } = point {
            let s = x + y
            s
        } else {
            0
        }></q>
    }

pub fn wrapped_condition_brace(count: &Cell[u8], ok: bool) -> &'static str:
    view! {
        <w on:click=move |ev| if ev > 0
            && ok
        {
            count.set(1)
            count.set(2)
        }></w>
    }

pub fn wrapped_let(value: Option[u8]) -> &'static str:
    view! {
        <o class=move || if let Some(x) =
            value {
            let y = x + 1
            y
        } else {
            0
        }></o>
    }

pub fn wrapped_comparison(count: &Cell[u8]) -> &'static str:
    view! {
        <i on:click=move |ev| if ev >
            0 {
            count.set(1)
            count.set(2)
        }></i>
    }

pub fn for_pattern(points: Vec[Point]) -> &'static str:
    view! {
        <r value=for Point {
            x,
            y,
        } in points {
            let s = x + y
            drop(s)
        }></r>
    }

pub fn for_attribute() -> &'static str:
    view! {
        <l for>
            {
                let a = 1
                a
            }
        </l>
    }

pub fn keyword_text() -> &'static str:
    view! {
        <x>Find a match</x>
        {
            let a = 1
            a
        }
    }

pub fn higher_ranked() -> &'static str:
    view! {
        <h on:click=move |ev: Box<dyn for<'a> Fn(&'a u8)>| {
            let a = 1
            ev(&a)
        }></h>
    }

pub fn nested_turbofish(pair: Pair[Vec[u8]]) -> &'static str:
    view! {
        <u class=move || if let Pair::<Vec<u8>> { x, .. } = pair {
            let n = x.len()
            n
        } else {
            0
        }></u>
    }

pub fn turbofish_list(result: Result[Vec[u8], ()]) -> &'static str:
    view! {
        <u class=move || if let Ok::<Vec<u8>, ()>(v) = result {
            let n = v.len()
            n
        } else {
            0
        }></u>
    }

pub fn cast_scrutinee(n: u8) -> &'static str:
    view! {
        <z class=match n as Same<u8> {
            0 => Point {
                x: 1,
                y: 2,
            },
            _ => Point { x: 0, y: 0 },
        }></z>
    }

pub fn glued_comparison(a: &str) -> &'static str:
    view! {
        <v class=match a>"x" {
            true => {
                let x = 1
                x
            }
            false => 2,
        }></v>
    }

pub fn qualified_path(n: u8) -> &'static str:
    view! {
        <b class=move || if let <u8>::MAX = n {
            let z = 1
            z
        } else {
            0
        }></b>
    }

pub fn comparison_text() -> &'static str:
    view! {
        <e>match x<y, then</e>
        {
            let z = 1
            z
        }
    }

pub fn self_closing_text() -> &'static str:
    view! {
        <j>Find a match<br/>
            {
                let x = 1
                x
            }
        </j>
    }
