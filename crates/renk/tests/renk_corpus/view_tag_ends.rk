// A stand-in for `view!` macros that type-checks the closure values and child blocks of tags that
// end at the first `>` outside groups, literals, and comments.
macro_rules! view:
    (<$tag:ident on:click=move |$e:tt| $f:ident() > Count $child:block </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() > Count $child:block more</$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() > Find a match $child:block </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() > Next -> $child:block </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > $limit:ident} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > $limit;
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), handler(1));
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > 5} title=$title:literal on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > 5;
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), handler(1), $title);
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > 5} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > 5;
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), handler(1));
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > 5} on:x={move |$x:tt| -> u8 { $($body:tt)* }} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > 5;
            let other = move |$x: u8| -> u8 { $($body)* };
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), other(1), handler(1));
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > $path:ident::<$ty:ty>($v:literal)} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > $path::<$ty>($v);
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), handler(1));
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > 5} class:odd={move || $m:ident > 1} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }></$close:ident>) =>:
        {
            let class = move || $n > 5;
            let odd = move || $m > 1;
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), odd(), handler(1));
            stringify!($tag)
        }
    (<$tag:ident class:big={move || $n:ident > 5} on:click=move |$e:tt| match $s:ident { $($arm:tt)* }/>) =>:
        {
            let class = move || $n > 5;
            let handler = move |$e: u8| match $s { $($arm)* };
            let _ = (class(), handler(1));
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() > Count $child:block > more </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() > a > b $child:block > c </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() >= Count $child:block > more </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() >> Count $child:block > more </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() -> Count $child:block </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident on:click=move |$e:tt| $f:ident() => Count $child:block </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident title=$value:tt on:click=move |$e:tt| $f:ident() > Count $child:block > more </$close:ident>) =>:
        {
            let handler = move |$e: u8| $f();
            let _ = ($value, handler(1), $child);
            stringify!($tag)
        }
    (<$tag:ident<$ty:ty> on:click=move |$e:tt| $f:ident() > Count $child:block > more </$close:ident>) =>:
        {
            let handler = move |$e: $ty| $f();
            let _ = (handler(1), $child);
            stringify!($tag)
        }
#[allow(unused_imports)]
pub(crate) use view

pub const COUNT: u8 = 5

pub fn go() -> u8 = 0

pub fn same[T](t: T) -> T = t

pub fn same_line_text() -> &'static str:
    view! {
        <a on:click=move |_| go() > Count
            {
                let z = 1
                z
            }
        </a>
    }

pub fn own_line_text() -> &'static str:
    view! {
        <b on:click=move |_| go()
            > Count
            {
                let z = 1
                z
            }
        </b>
    }

pub fn keyword_text() -> &'static str:
    view! {
        <c on:click=move |_| go() > Find a match {
            let z = 1
            z
        }
        </c>
    }

pub fn arrow_text() -> &'static str:
    view! {
        <d on:click=move |_| go() > Next -> {
            let z = 1
            z
        }
        </d>
    }

pub fn glued_close_text() -> &'static str:
    view! {
        <e on:click=move |_| go() > Count
            {
                let z = 1
                z
            }
            more</e>
    }

pub fn uppercase_comparison(n: u8) -> &'static str:
    view! {
        <f class:big={move || n > COUNT} on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }></f>
    }

pub fn string_after_comparison(n: u8) -> &'static str:
    view! {
        <g class:big={move || n > 5} title="<a>" on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }></g>
    }

pub fn comment_after_comparison(n: u8) -> &'static str:
    view! {
        <h class:big={move || n > 5} // <a>
            on:click=move |_| match n {
                1 => 2,
                _ => 3,
            }></h>
    }

pub fn arrow_after_comparison(n: u8) -> &'static str:
    view! {
        <i class:big={move || n > 5} on:x={move |_| -> u8 { 1 }} on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }></i>
    }

pub fn turbofish_after_comparison(n: u8) -> &'static str:
    view! {
        <j class:big={move || n > same::<u8>(5)} on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }></j>
    }

pub fn two_comparisons(n: u8) -> &'static str:
    view! {
        <k class:big={move || n > 5} class:odd={move || n > 1} on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }></k>
    }

pub fn self_closing_comparison(n: u8) -> &'static str:
    view! {
        <l class:big={move || n > 5} on:click=move |_| match n {
            1 => 2,
            _ => 3,
        }/>
    }

pub fn text_after_block() -> &'static str:
    view! {
        <m on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </m>
    }

pub fn own_line_text_after_block() -> &'static str:
    view! {
        <o on:click=move |_| go()
            > Count {
                let z = 1
                z
            }
            > more
        </o>
    }

pub fn bare_greater_text() -> &'static str:
    view! {
        <q on:click=move |_| go() > a > b {
            let z = 1
            z
        } > c </q>
    }

pub fn greater_equal_tag_end() -> &'static str:
    view! {
        <r on:click=move |_| go() >= Count {
            let z = 1
            z
        } > more </r>
    }

pub fn shift_tag_end() -> &'static str:
    view! {
        <s on:click=move |_| go() >> Count {
            let z = 1
            z
        } > more </s>
    }

pub fn arrow_tag_end() -> &'static str:
    view! {
        <t on:click=move |_| go() -> Count {
            let z = 1
            z
        }
        </t>
    }

pub fn fat_arrow_tag_end() -> &'static str:
    view! {
        <u on:click=move |_| go() => Count {
            let z = 1
            z
        }
        </u>
    }

pub fn greater_in_parentheses(n: u8) -> &'static str:
    view! {
        <v title=(n > 5) on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </v>
    }

pub fn greater_in_brackets(n: u8) -> &'static str:
    view! {
        <w title=[n > 5] on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </w>
    }

pub fn greater_in_braces(n: u8) -> &'static str:
    view! {
        <x title={n > 5} on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </x>
    }

pub fn greater_in_string() -> &'static str:
    view! {
        <y title=">" on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </y>
    }

pub fn greater_in_char() -> &'static str:
    view! {
        <z title='>' on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </z>
    }

pub fn greater_in_line_comment() -> &'static str:
    view! {
        <aa title="a" // >
            on:click=move |_| go() > Count {
                let z = 1
                z
            } > more </aa>
    }

pub fn greater_in_block_comment() -> &'static str:
    view! {
        <ab title="a" /* > */ on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </ab>
    }

pub fn generic_tag_name() -> &'static str:
    view! {
        <ac<u8> on:click=move |_| go() > Count {
            let z = 1
            z
        } > more </ac>
    }
