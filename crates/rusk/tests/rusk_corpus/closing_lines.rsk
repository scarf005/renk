const LIMIT: usize = 2

pub fn sorted(mut xs: Vec[i32]) -> Vec[i32]:
    xs.sort_by(|a, b|:
        b.cmp(a)
    )
    xs

pub fn doubled_total(xs: &[i32]) -> i32:
    xs.iter().map(|x|:
        let y = x * 2 // (
        y
    ).sum()

pub fn chained(xs: &[i32]) -> usize:
    xs
        .iter()
        .filter(|x|:
            let text = "(" // ends in (
            **x > text.len() as i32
        )
        .count()

pub fn spawned() -> u8:
    std::thread::spawn(move || -> u8:
        1 + 1
    ).join().unwrap_or(0)

pub fn parsed(text: &str) -> Result[usize, std::num::ParseIntError]:
    let n = Some(text).map(|s|:
        s.parse[usize]()
    ).unwrap()?
    Ok(n)

pub fn larger(a: Option[usize], c: bool) -> usize:
    let m = std::cmp::max(match a:
        Some(x) => x
        None => 0
    , LIMIT)
    match a:
        Some(p) => std::cmp::max(if c:
            p
        else:
            2
        , m)
        None => m

pub fn nested(xs: Vec[Vec[u8]]) -> Vec[usize]:
    xs.into_iter().map(|row| row.into_iter().map(|x|:
        x as usize * LIMIT
    ).sum()).collect()

pub fn in_brackets(xs: &[u8]) -> [usize; 1]:
    [xs.iter().map(|x|:
        *x as usize
    ).sum()]

pub fn arm(o: Option[Vec[u8]]) -> usize:
    match o:
        Some(v) => v.iter().map(|x|:
            *x as usize
        ).sum()
        None => 0

pub fn macro_receiver() -> usize:
    vec![1usize, 2].iter().map(|X|:
        X + 1
    ).sum()

pub fn brace_closure(xs: &[i32]) -> i32:
    xs.iter().map(|x| {
        x * 2
    }).sum()

pub fn one_line_forms(xs: &[i32], c: bool) -> i32:
    let total = xs.iter().map(|x| x * 2).sum[i32]()
    let pick = std::cmp::max(if c {
        total
    else if total > 1 then 1 else 0
    , 0) // closes max(
    pick

macro_rules! wrapped:
    ($value:expr) =>:
        std::convert::identity({
            let v = $value;
            v
        })

pub fn use_wrapped() -> u8 = wrapped!(1)

pub fn block_arguments(a: Option[usize], b: Option[usize]) -> usize:
    let m = std::cmp::max(match a:
        Some(x) => x // ,
        None => 0
    , match b:
        Some(X) => X
        None => 0
    )
    let n = a.map_or_else(||:
        let text = ")" // ends in )
        text.len()
    , |x|:
        x * LIMIT
    )
    let total = b.map_or_else(|| {
        m
    }, |X| {
        X + n
    })
    [total].iter().map(|x|:
        *x
    // before the closer
    ).sum()

pub struct Holder:
    pub n: usize

pub fn held(xs: &[usize]) -> usize:
    let h = Holder { n: xs.iter().map(|x| {
        *x + "}".len()
    }).sum()}
    let i = Holder { n: xs.iter().map(|X|:
        X * 2 // }
    ).sum() }
    h.n + i.n

pub fn braced_tails(xs: &[usize]) -> usize:
    let h = Holder { n: xs.iter().map(|X|:
        X + "})".len() // })
    ).sum() }.n
    let i = Holder { n: xs.iter().fold(0, |acc, x| {
        acc + *x
    })}.n
    let j = Holder { n: xs.iter().fold(0, |acc, X|:
        acc + X // )}
    )}.n
    h + i + j

const A_MAX: u8 = 9
const C_ON: bool = true

pub fn grouped_heads(c: bool, a: u8) -> usize:
    let m = std::convert::identity(if c:
        LIMIT // )
    else:
        "])".len()
    )
    let n = [match a:
        0 => m
        A_MAX => m + 1 // ]
        _ => 2
    ]
    let o = (n[0], if C_ON:
        m
    else:
        0
    )
    std::convert::identity(if C_ON:
        n[0] + o.1
    else if c:
        m
    else:
        0
    ).max(n[0])
