// `= match` owns its arms like a block body.
pub fn describe(n: i32) -> &'static str = match n: // trailing comment
    0 => "zero"
    MAX =>:
        let _ = n
        "max"
    _ => "other"

pub fn format_macros(out: &mut String, names: &[&str]) -> std::fmt::Result:
    use std::fmt::Write
    eprintln!("{names.len()} {}", 1)
    write!(out, "{names.len():>4}")?
    writeln!(
        out,
        "{names.first().copied().unwrap_or_default()}"
    )?
    let note = "eprintln!(\"{names.len()}\")"
    if names.is_empty():
        panic!("{note.len()}") // eprintln!("{names.len()}")
    Ok(())

pub fn let_else(v: Option<i32>) -> i32:
    let Some(x) = v else:
        return 0
    let s = "let a = b else:" // let c = d else:
    let Some(y) = v.map(|n| n + s.len() as i32) else: // none
        return 1
    if x > y:
        let Some(z) = v else:
            return 2
        z
    else:
        x

pub fn trailing_if(n: i32) -> i32:
    let size = if n > 10:
        1
    else if n < 0: // negative
        2
    else:
        3
    let s = "let a = if b:" // let c = if d:
    let t = if n > 0 then 1 else 2
    let mut total = vec![size, t].len() as i32
    total += if i32::MAX > n:
        let inner = if n % 2 == 0:
            n
        else:
            -n
        inner
    else:
        0
    let notif = size
    return if total == 0:
        notif + t
    else:
        s.len() as i32

pub fn explicit_path_receivers() -> usize:
    let command = std::process::Command.new("true") // std::process::Command.new(
    let text = "std::string::String.new(" // ends in (
    let built = std::string::String.from(text)
    let order = (std::cmp::Ordering::Less).reverse()
    let bits = i32::MAX.count_ones() as usize
    let size = std::cmp::max(
        std::string::String.new().len(),
        std::f64::consts::PI.to_bits() as usize,
    )
    let nested = std::cmp::max(std::vec::Vec[u8].new().len(), built.len())
    if order.is_gt() then command.get_args().len() + bits + size + nested else 0

pub fn statement_blocks(c: bool) -> usize:
    let mut seen = std::collections::HashMap.new()
    'outer: for i in 0..3:
        seen.insert(i, i)
        while c:
            seen.insert(9, 9) // insert:
            break 'outer
    if c:
        seen.insert(1, 1) // ends in {
    match c:
        true => seen.insert(2, 2)
        false => None
    loop:
        seen.insert(3, 3)
        break
    let kept = if c:
        seen.insert(4, 4)
    else:
        None
    drop(kept)
    seen.len()

pub fn unit_tail(c: bool):
    let mut values = vec![1]
    if c:
        values.pop()
    else if values.is_empty():
        values.pop()
    else:
        values.first().copied()

macro_rules! keep:
    ($value:expr) => $value

pub fn std_macro_arguments(flag: bool) -> usize:
    let words = vec![String.from("a, b"), std.string::String.new()]
    let sizes = vec![
        words[0].len(), // a, b
        Vec[u8].new().len(),
    ]
    let repeated = vec![String.new(); 2]
    assert!(words.iter().any(|w| w.len() < std.usize.MAX), "missing {words.len()}")
    assert_eq!(sizes.len(), if flag then 2 else 2, "{}, {}", "x, y", repeated.len())
    debug_assert_ne!(std.cmp::Ordering.Less, std.cmp::Ordering.Greater)
    let ordered = matches!((std.cmp::Ordering.Less).reverse(), std.cmp::Ordering.Greater | std.cmp::Ordering.Equal)
    let kept = keep!(sizes.len())
    let shown = format!("{} {}", dbg!(String.from("a").len()), vec![Vec[u8].new()].len())
    println!("{}", if ordered then shown.len() else kept)
    sizes.iter().sum[usize]() + repeated.len()

mod helpers:
    pub fn twice(n: usize) -> usize = n * 2

pub fn imported_module_paths() -> usize:
    use std.{env, fmt.Write as _}
    let mut shown = String.new()
    let _ = write!(shown, "{}", env.args().count()) // env.args(
    let env_name = "env.var(" // ends in (
    helpers.twice(shown.len() + env_name.len())

pub fn closure_blocks(mut xs: Vec[i32], a: bool, b: bool) -> usize:
    let describe = |n: usize| -> String: // returns String:
        if n > 1 then format!("long {n}") else "short".to_string()
    let shout = move |s: &str|:
        let upper = s.to_uppercase() // ends in |:
        upper + "|:"
    xs.sort_by(|a, b|:
        b.cmp(a)
    )
    let total = std::thread::spawn(move ||:
        1 + 1
    )
    if a || b:
        xs.clear()
    describe(2).len() + shout("a").len() + total.join().unwrap_or(0) as usize

static NAMES: [&str; 2] = ["a", "b"]

pub fn value_bound_names(path: &str, 목록: Vec[u8], pair: (Option[String], u8)) -> usize:
    use std.env
    let first = NAMES[0].len() + NAMES.len() // NAMES.len(
    let args = env.args().count()
    let env = path.trim() // a local named like the module
    let size = env.len() + 목록.len() + make_pair().1.count_ones() as usize
    fn nested() -> usize = env.args().count()
    let inner = if let (Some(env), _) = &pair then env.len() else 0
    let some = matches!(pair.0, Some(ref env) if env.len() > 1)
    let lens = NAMES.iter().map(|env| env.len()).sum[usize]()
    let block = { let env = 2usize; env.pow(2) }
    for (index, env) in NAMES.iter().enumerate():
        assert!(env.len() >= index.min(1), "{env.len()}")
    match pair.0.as_deref():
        Some(env) if env.len() > 3 => helpers.twice(env.len())
        _ => std.cmp.max(first, args) + size + nested() + inner + usize.from(some) + lens + block + (0..NAMES.len()).len()

fn make_pair() -> (u8, u8) = (1, 2)

pub fn brace_matches(o: Option[u8]) -> u8:
    let a = match o {
        Some(x) => x, // y,
        None => (0, 1).0,
    }
    let b = match o {
        Some(1) => {
            a
        },
        Some(x) => {
            x
        }
        None => 0,
    }
    match o {
        Some(x) => x + b,
        None => 0 // z,
    }

pub fn closure_scoped_names() -> usize:
    let n = [1u8].iter().map(|env| *env as usize).sum[usize]() + env.args().count()
    let m = [1u8].iter().map(|env: &u8| *env as usize).sum[usize]() + env.vars().count()
    let k = |env: usize| env + 1
    n + m + k(env.args().len())

pub fn closure_closing_lines(v: Vec[u8]) -> usize:
    let n = v.iter().map(|env| {
        env.count_ones() as usize
    }).sum[usize]() + env.args().count() // sum
    n

pub fn chain_closing_lines(c: bool):
    let n = [vec![String.new()]].iter().map(|env| {
        let r = env.iter().map(|x| if c {
            x.len()
        else:
            2
        }).count() + env.len()
        r
    }).sum[usize]()
    std.mem.drop(n)

pub struct Z:
    pub y: u8

fn pass_on(a: u8) -> u8 = a

pub fn tail_after_statement(z: Z) -> u8:
    let _s = "a;
    b"; z.y + 1

pub fn tail_after_assignment(z: Z) -> u8:
    let mut v = 0
    v = pass_on(*&{ pass_on(v); z.y }); v // v;

mod s:
    pub fn y() -> u8 = 1

pub fn let_on_the_line() -> usize:
    let s = "a;"; s.len()

pub fn let_over_lines() -> usize:
    let s = "a;
    b"; s.len()

pub fn path_before_let() -> u8:
    let t = s.y(); let s = 1; t + s

pub fn let_before_inline_ifs() -> usize:
    let s = "a"; let n = if s.is_empty() then 0 else s.len(); n

const C: bool = true

pub struct Sized2:
    pub data: [u64; if C {
        1
    } else {
        2
    }]

fn first_of(v: [u8; 1]) -> u8 = v[0]

pub fn blocks_in_brackets(a: u8, c: bool) -> u8:
    let y = [match a {
        0 => 1 // 1 => [
        _ => 2
    }]
    let v = first_of([match a {
        0 => 1
        _ => 2
    }])
    let e = [if c {
        let b = 1
        b
    } else {
        2
    }]
    y[0] + v + e[0]

fn pair_sum(a: u8, b: u8) -> u8 = a + b

pub fn one_line_else_arms(c: bool, o: Option[u8]) -> u8:
    let a = match o:
        Some(x) => if c:
            x
        else { 2 },
        None => pair_sum(if c:
            1
        else { 2 }, 3)
    a
